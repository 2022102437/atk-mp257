+
+	ret = ytphy_write_ext(phydev, YTPHY_SYNCE_CFG_REG, 0xd0);
+	if (ret < 0)
+		return ret;
+
+	/* soft reset (mirrors 0xa001 |= BIT(15) in the ALIENTEK driver) */
+	ret = ytphy_modify_ext(phydev, YT8521_CHIP_CONFIG_REG, 0, YT8521_CCR_SW_RST);
+	if (ret < 0)
