From f278fdb213739ddf112ef48f6d2d33904dd2e6e0 Mon Sep 17 00:00:00 2001
From: Florian LEPELTIER <florian.lepeltier@st.com>
Date: Wed, 17 Sep 2025 15:04:54 +0200
Subject: [PATCH 5/5] conf: add card config for stm32mp23 dk board

Add ALSA card configuration file for STM32MP23 DK boards.

Upstream-Status: Pending [specific to ST boards]
Signed-off-by: Florian LEPELTIER <florian.lepeltier@st.com>
---
 src/conf/cards/Makefile.am      |  1 +
 src/conf/cards/STM32MP23DK.conf | 16 ++++++++++++++++
 src/conf/cards/aliases.conf     |  1 +
 3 files changed, 18 insertions(+)
 create mode 100644 src/conf/cards/STM32MP23DK.conf

diff --git a/src/conf/cards/Makefile.am b/src/conf/cards/Makefile.am
index 4fd7308..eb5c561 100644
--- a/src/conf/cards/Makefile.am
+++ b/src/conf/cards/Makefile.am
@@ -62,6 +62,7 @@ cfg_files = aliases.conf \
 	STM32MP15EV.conf \
 	STM32MP15DK.conf \
 	STM32MP13EV1.conf \
+	STM32MP23DK.conf \
 	STM32MP25EV1.conf \
 	STM32MP25DK.conf
 
diff --git a/src/conf/cards/STM32MP23DK.conf b/src/conf/cards/STM32MP23DK.conf
new file mode 100644
index 0000000..cee1476
--- /dev/null
+++ b/src/conf/cards/STM32MP23DK.conf
@@ -0,0 +1,16 @@
+<confdir:pcm/hdmi.conf>
+
+STM32MP23DK.pcm.hdmi.0 {
+        @args [ CARD AES0 AES1 AES2 AES3 ]
+        @args.CARD { type string }
+        @args.AES0 { type integer }
+        @args.AES1 { type integer }
+        @args.AES2 { type integer }
+        @args.AES3 { type integer }
+        type asym
+        playback.pcm {
+                type hw
+                card $CARD
+                device 0
+        }
+}
diff --git a/src/conf/cards/aliases.conf b/src/conf/cards/aliases.conf
index 2e2e8e2..9beb40b 100644
--- a/src/conf/cards/aliases.conf
+++ b/src/conf/cards/aliases.conf
@@ -60,6 +60,7 @@ VC4-HDMI cards.vc4-hdmi
 STM32MP15-EV cards.STM32MP15EV
 STM32MP15-DK cards.STM32MP15DK
 STM32MP13-EV1 cards.STM32MP13EV1
+STM32MP23-DK cards.STM32MP23DK
 STM32MP25-EV1 cards.STM32MP25EV1
 STM32MP25-DK cards.STM32MP25DK
 
-- 
2.25.1

